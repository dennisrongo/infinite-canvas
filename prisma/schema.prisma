generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String               @map("password_hash")
  displayName         String?              @map("display_name")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  lastLogin           DateTime?            @map("last_login")
  canvases            Canvas[]
  folders             Folder[]
  passwordResetTokens PasswordResetToken[]
  settings            UserSettings?

  @@map("users")
}

model UserSettings {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  theme     String   @default("light")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Folder {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  canvases  Canvas[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("folders")
}

model Canvas {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  folderId    String?          @map("folder_id")
  name        String
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  folder      Folder?          @relation(fields: [folderId], references: [id])
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connections NoteConnection[]
  notes       Note[]

  @@index([userId])
  @@index([folderId])
  @@map("canvases")
}

model Note {
  id                String           @id @default(uuid())
  canvasId          String           @map("canvas_id")
  title             String
  content           String
  positionX         Float            @map("position_x")
  positionY         Float            @map("position_y")
  width             Float            @default(300)
  height            Float            @default(200)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  images            Image[]
  targetConnections NoteConnection[] @relation("TargetNote")
  sourceConnections NoteConnection[] @relation("SourceNote")
  canvas            Canvas           @relation(fields: [canvasId], references: [id], onDelete: Cascade)

  @@index([canvasId])
  @@index([title])
  @@map("notes")
}

model NoteConnection {
  id           String   @id @default(uuid())
  canvasId     String   @map("canvas_id")
  sourceNoteId String   @map("source_note_id")
  targetNoteId String   @map("target_note_id")
  createdAt    DateTime @default(now()) @map("created_at")
  targetNote   Note     @relation("TargetNote", fields: [targetNoteId], references: [id], onDelete: Cascade)
  sourceNote   Note     @relation("SourceNote", fields: [sourceNoteId], references: [id], onDelete: Cascade)
  canvas       Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)

  @@index([canvasId])
  @@index([sourceNoteId])
  @@index([targetNoteId])
  @@map("note_connections")
}

model Image {
  id          String   @id @default(uuid())
  noteId      String   @map("note_id")
  storagePath String   @map("storage_path")
  fileName    String   @map("file_name")
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at")
  note        Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@map("images")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_reset_tokens")
}

model RevokedToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([token])
  @@index([userId])
  @@map("revoked_tokens")
}
